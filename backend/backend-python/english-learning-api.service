[Unit]
Description=English Learning AI API
After=network.target
Wants=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/english-learning-api
Environment=PATH=/opt/english-learning-api/venv/bin
Environment=PYTHONPATH=/opt/english-learning-api
Environment=PORT=1423
Environment=WS_PORT=1424
ExecStart=/opt/english-learning-api/venv/bin/gunicorn -c gunicorn.conf.py app.main:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/english-learning-api/uploads /var/log/english-learning-api

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target 